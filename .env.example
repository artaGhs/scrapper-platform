# Server-only keys. Never commit .env or .env.local.
OPENAI_API_KEY=
# Reddit MVP: GPT-5.4 Mini with medium reasoning and web search.
# Apify/Gemini remain available for legacy scans.
APIFY_TOKEN=
# Required for production live query planning; sample mode needs no model key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Defaults disable live calls. Enabled per-run source cap 0.04–1; hourly reservation cap <= 10.
LIVE_SCAN_BUDGET_USD=0
LIVE_HOURLY_BUDGET_USD=5
# Rolling 24-hour global reservation cap. Defaults to the hourly cap when omitted.
LIVE_DAILY_BUDGET_USD=10
# Optional locally (SQLite fallback); required on Vercel (Neon Postgres).
DATABASE_URL=
# Optional existing database namespace during a coordinated branding migration.
DATABASE_SCHEMA=
# Required when running scripts/validate-hosted.ts against the deployed app.
HOSTED_APP_URL=
SCAN_DB_PATH=.data/scans.sqlite

# Current free X actor: at most 10 items/run, 5 runs/month. Change allowance only after verifying entitlement.
X_MONTHLY_RUN_LIMIT=5

# Optional private developer login; random value of at least 32 characters. Never expose with NEXT_PUBLIC_.
DEVELOPER_ACCESS_KEY=
# AWS App Monetization. Enable live only after seller onboarding, publishing and launch approval.
# Hosting uses its dedicated service role; never configure root access keys.
MONETIZATION_ENABLED=false
MONETIZATION_APP_ID=
MONETIZATION_EVENT_TYPE=
MONETIZATION_RETURN_ORIGIN=
# Obtain a verified endpoint from the AWS beta team; do not guess an endpoint.
# Endpoint, signing Region and app ARN must match the payment service's Region.
MONETIZATION_ENDPOINT=
MONETIZATION_REGION=us-west-2

MONETIZATION_MODE=sandbox
MONETIZATION_LIVE_APPROVED=false
MONETIZATION_STARTER_PLAN_ID=
MONETIZATION_PRO_PLAN_ID=
MONETIZATION_EXECUTION_ROLE_ARN=
# Cognito managed login and server-side OAuth state signing.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
AUTH_ORIGIN=http://localhost:3000
AUTH_SESSION_SECRET=
