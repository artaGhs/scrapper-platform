# Server-only keys. Never commit .env or .env.local.
APIFY_TOKEN=
# Required for production live query planning; sample mode needs no model key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Defaults disable live calls. Enabled per-run source cap 0.04–1; hourly reservation cap <= 10.
LIVE_SCAN_BUDGET_USD=0
LIVE_HOURLY_BUDGET_USD=0.08
# Rolling 24-hour global reservation cap. Defaults to the hourly cap when omitted.
LIVE_DAILY_BUDGET_USD=0.08
# Optional locally (SQLite fallback); required on Vercel (Neon Postgres).
DATABASE_URL=
SCAN_DB_PATH=.data/scans.sqlite

# Current free X actor: at most 10 items/run, 5 runs/month. Change allowance only after verifying entitlement.
X_MONTHLY_RUN_LIMIT=5

# Optional private developer login; random value of at least 32 characters. Never expose with NEXT_PUBLIC_.
DEVELOPER_ACCESS_KEY=
